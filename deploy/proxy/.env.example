PROD_DOMAIN=kemdia.ga
STAGING_DOMAIN=staging.kemdia.ga
STAGING_USER=equipe
# Générer avec : docker run --rm caddy:2-alpine caddy hash-password --plaintext 'MotDePasseLong'
