# Vérification hebdomadaire : la dernière sauvegarde se restaure-t-elle ? (S7-T05, ADR-0044)
[Unit]
Description=Kemdia — vérification de restauration des sauvegardes
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/opt/kemdia/bin/restore.sh verifier
Nice=10
IOSchedulingClass=idle
# Une copie S3 bloquée ne doit pas empêcher les nuits suivantes
TimeoutStartSec=4h
# Confinement : écriture seulement dans les dépôts, le cache, l'état de Kemdia et /run (socket Docker, verrou)
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=-/var/backups/kemdia -/var/cache/kemdia-restic /opt/kemdia/state /run
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
