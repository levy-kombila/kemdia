{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "inputs": ["prisma/schema/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"],
      "passThroughEnv": ["PRISMA_ENGINES_MIRROR", "PRISMA_SCHEMA_ENGINE_BINARY"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": { "dependsOn": ["^build", "generate"] },
    "typecheck": { "dependsOn": ["^build", "generate"] },
    "test": { "dependsOn": ["^build", "generate"] },
    "dev": { "dependsOn": ["^build", "generate"], "cache": false, "persistent": true }
  }
}
