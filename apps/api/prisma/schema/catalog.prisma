// Module catalog : catégories, produits, variantes, stock (S3-T03).
// Chaque modèle de ce fichier porte @@schema("catalog").
// Règles complémentaires posées en SQL dans la migration (Prisma ne sait pas les décrire) :
// prix > 0, stock >= 0, prix barré > prix, note entre 0 et 5.

/// Statut d'un produit : DRAFT (préparation), PENDING (en attente de modération, BR-003), PUBLISHED (visible),
/// REJECTED (refusé par la modération, S6-T02), ARCHIVED (désactivé, BR-002).
enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  PENDING
  REJECTED

  @@map("product_status")
  @@schema("catalog")
}

/// Catégorie (arborescence de 4 niveaux au plus, vérifiée par le domaine).
model Category {
  /// BR-042 : identifiant public UUID, jamais un numéro qui se suit
  id        String     @id @db.Uuid
  slug      String     @unique @db.VarChar(120)
  name      String     @db.VarChar(80)
  parentId  String?    @map("parent_id") @db.Uuid
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  icon      String     @db.VarChar(40)
  image     String?    @db.VarChar(200)
  position  Int        @default(0)
  products  Product[]
  listings  Listing[]
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([parentId])
  @@map("categories")
  @@schema("catalog")
}

/// Fiche commune (S7.5-T02, ADR-0049) : ce que le client voit d'un produit (titre, description, marque, photos,
/// déclinaisons), quelle que soit la boutique qui le vend. Chaque boutique y pose son OFFRE (`Product` : prix, stock).
/// Créée par un vendeur (modérée) ou par Kemdia ; une fois publiée, seule l'équipe la modifie.
/// `price`, `compareAtPrice` et `offerCount` sont tenus par la base (déclencheur sur les offres) : prix « à partir de »
/// parmi les offres visibles, nombre d'offres visibles.
model Listing {
  /// Une fiche créée avec une offre reprend l'identifiant et l'adresse de cette offre (données d'avant le S7.5 comprises)
  id              String              @id @db.Uuid
  slug            String              @unique @db.VarChar(120)
  title           String              @db.VarChar(120)
  description     String              @default("")
  brand           String?             @db.VarChar(60)
  categoryId      String              @map("category_id") @db.Uuid
  category        Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images          String[]            @default([])
  /// PUBLISHED : visible (si au moins une offre est visible) ; avant publication, suit l'offre de la boutique qui l'a créée
  status          ProductStatus       @default(DRAFT)
  /// Boutique qui a créé la fiche (vendors, UUID) ; ses photos sont rangées avec l'offre de cette boutique
  createdByShopId String              @map("created_by_shop_id") @db.Uuid
  /// Doublon fusionné par l'équipe : l'ancienne adresse mène à cette fiche
  mergedIntoId    String?             @map("merged_into_id") @db.Uuid
  mergedInto      Listing?            @relation("ListingMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom      Listing[]           @relation("ListingMerge")
  price           Int                 @default(0)
  compareAtPrice  Int?                @map("compare_at_price")
  offerCount      Int                 @default(0) @map("offer_count")
  rating          Float               @default(0)
  reviewCount     Int                 @default(0) @map("review_count")
  isFeatured      Boolean             @default(false) @map("is_featured")
  isBestseller    Boolean             @default(false) @map("is_bestseller")
  isNew           Boolean             @default(false) @map("is_new")
  searchText      String              @default("") @map("search_text")
  variants        ListingVariant[]
  offers          Product[]
  corrections     ListingCorrection[]
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([categoryId])
  @@index([status, offerCount, price])
  @@index([mergedIntoId])
  /// Recherche tolérante aux fautes (S7.5-T06, ADR-0053) : index trigrammes (extension pg_trgm)
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "listings_search_text_trgm_idx")
  @@map("listings")
  @@schema("catalog")
}

/// Déclinaison commune d'une fiche (« Noir · 128 Go ») : les offres des boutiques s'y rattachent.
model ListingVariant {
  id         String           @id @db.Uuid
  listingId  String           @map("listing_id") @db.Uuid
  listing    Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  name       String           @db.VarChar(80)
  attributes Json             @default("{}")
  position   Int              @default(0)
  offers     ProductVariant[]
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([listingId])
  @@map("listing_variants")
  @@schema("catalog")
}

/// Correction d'une fiche en ligne proposée par une boutique qui la vend (S7.5-T03) : message libre lu par l'équipe,
/// qui corrige la fiche puis clôt la proposition. Aucune donnée personnelle : la boutique, jamais le compte.
model ListingCorrection {
  id        String    @id @db.Uuid
  listingId String    @map("listing_id") @db.Uuid
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  /// Boutique qui propose (vendors, UUID)
  shopId    String    @map("shop_id") @db.Uuid
  message   String    @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Clôture par l'équipe : qui, quand, avec quelle réponse
  closedBy  String?   @map("closed_by") @db.Uuid
  closedAt  DateTime? @map("closed_at") @db.Timestamptz(3)
  note      String?   @db.VarChar(300)

  @@index([closedAt, createdAt, id])
  @@index([listingId])
  @@index([shopId])
  @@map("listing_corrections")
  @@schema("catalog")
}

/// Boutique telle que le catalogue l'affiche à côté d'une offre (S7.5-T02) : copie tenue par le module vendors
/// (validation, suspension, réactivation), pour ne jamais lire ses tables.
model Seller {
  shopId    String   @id @map("shop_id") @db.Uuid
  name      String   @db.VarChar(60)
  slug      String   @db.VarChar(80)
  city      String   @db.VarChar(60)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("sellers")
  @@schema("catalog")
}

/// Offre d'une boutique sur une fiche (S7.5-T02 ; avant : « produit »). Titre, description, marque, catégorie et photos
/// sont COPIÉS de la fiche par la base (lecture seule ici). `price` et `compareAtPrice` reprennent la variante active la
/// moins chère de l'offre. Une boutique a au plus une offre par fiche.
model Product {
  id               String           @id @db.Uuid
  slug             String           @unique @db.VarChar(120)
  listingId        String           @map("listing_id") @db.Uuid
  listing          Listing          @relation(fields: [listingId], references: [id], onDelete: Restrict)
  title            String           @db.VarChar(120)
  description      String           @default("")
  brand            String?          @db.VarChar(60)
  categoryId       String           @map("category_id") @db.Uuid
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Boutique qui vend le produit (module vendors, UUID, S6-T01) ; par défaut la boutique Kemdia (KEMDIA_SHOP_ID).
  /// `dbgenerated` : forme exacte gardée par PostgreSQL (`'…'::uuid`) ; avec `@default("…")`, `db:check` voyait
  /// toujours une différence (Prisma réécrit la valeur, PostgreSQL la range de nouveau avec `::uuid`).
  shopId           String           @default(dbgenerated("'6b656d64-6961-4000-8000-000000000001'::uuid")) @map("shop_id") @db.Uuid
  images           String[]         @default([])
  status           ProductStatus    @default(DRAFT)
  /// Boutique suspendue (S6-T02) : produit caché, quel que soit son statut ; tenu à jour par le module vendors
  shopSuspended    Boolean          @default(false) @map("shop_suspended")
  /// Modération (BR-003, S6-T02) : dernière demande du vendeur, motif d'un refus, dernière décision
  submittedAt      DateTime?        @map("submitted_at") @db.Timestamptz(3)
  moderationReason String?          @map("moderation_reason") @db.VarChar(300)
  reviewedBy       String?          @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?        @map("reviewed_at") @db.Timestamptz(3)
  price            Int
  compareAtPrice   Int?             @map("compare_at_price")
  rating           Float            @default(0)
  reviewCount      Int              @default(0) @map("review_count")
  isFeatured       Boolean          @default(false) @map("is_featured")
  isBestseller     Boolean          @default(false) @map("is_bestseller")
  isNew            Boolean          @default(false) @map("is_new")
  /// Titre, marque, catégorie et caractéristiques en minuscules sans accents (recherche)
  searchText       String           @default("") @map("search_text")
  variants         ProductVariant[]
  /// Photos envoyées par le vendeur (S6-T04) ; leur ordre et leurs adresses sont dans `images`
  vendorImages     ProductImage[]
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([listingId, shopId])
  @@index([categoryId])
  @@index([shopId])
  @@index([status, price])
  @@index([status, submittedAt, id])
  @@map("products")
  @@schema("catalog")
}

/// Variante d'une offre (FR-013) : prix et stock propres à la boutique, rattachée à une déclinaison de la fiche dont
/// elle copie le nom et les caractéristiques (base).
model ProductVariant {
  id               String         @id @db.Uuid
  productId        String         @map("product_id") @db.Uuid
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  listingVariantId String         @map("listing_variant_id") @db.Uuid
  listingVariant   ListingVariant @relation(fields: [listingVariantId], references: [id], onDelete: Restrict)
  sku              String         @unique @db.VarChar(40)
  name             String         @db.VarChar(80)
  /// Caractéristiques : { "couleur": "Noir", "taille": "M" }
  attributes       Json           @default("{}")
  price            Int
  compareAtPrice   Int?           @map("compare_at_price")
  stock            Int            @default(0)
  isActive         Boolean        @default(true) @map("is_active")
  position         Int            @default(0)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([productId, listingVariantId])
  @@index([productId])
  @@index([listingVariantId])
  @@map("product_variants")
  @@schema("catalog")
}

/// Photo d'un produit de vendeur (S6-T04, ADR-0035) : réencodée en WebP sans métadonnées, en deux tailles.
/// Adresse sur le site : « /images/v/<id>.webp » (grande) et « /images/v/<id>-480.webp » (vignette), dans `Product.images`.
/// Règles posées en SQL : tailles cohérentes et bornées, en-tête WebP, dimensions bornées.
model ProductImage {
  id        String   @id @db.Uuid
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Grande image (1 600 px au plus sur le plus grand côté)
  large     Bytes
  /// Vignette (480 px au plus)
  small     Bytes
  /// Dimensions de la grande image
  width     Int
  height    Int
  /// Empreinte SHA-256 de la grande image (ETag)
  sha256    String   @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([productId])
  @@map("product_images")
  @@schema("catalog")
}
