// Module vendors : boutiques des vendeurs (S6-T01, ADR-0032).
// Chaque modèle de ce fichier porte @@schema("vendors").
// Règles complémentaires posées en SQL dans la migration (Prisma ne sait pas les décrire) :
// boutique Kemdia unique, sans propriétaire et toujours active ; boutique d'un vendeur avec propriétaire et mobile
// gabonais ; longueurs des textes ; motif obligatoire pour un refus ou une suspension ; personne ne valide sa boutique.

/// Statut : PENDING (demande à examiner), ACTIVE (validée), REJECTED (refusée), SUSPENDED (suspendue).
enum ShopStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED

  @@map("shop_status")
  @@schema("vendors")
}

/// KEMDIA : la boutique de Kemdia (une seule) ; PARTNER : boutique d'un vendeur tiers.
enum ShopKind {
  KEMDIA
  PARTNER

  @@map("shop_kind")
  @@schema("vendors")
}

/// Boutique. Une par compte. Les produits du catalogue la désignent par `catalog.products.shop_id` (UUID, sans relation).
model Shop {
  /// BR-042 : identifiant public UUID
  id             String     @id @db.Uuid
  kind           ShopKind   @default(PARTNER)
  /// Compte du vendeur (module identity, UUID) ; vide pour la boutique Kemdia
  ownerAccountId String?    @unique @map("owner_account_id") @db.Uuid
  name           String     @db.VarChar(60)
  /// Nom en minuscules sans accents ni ponctuation, signes ressemblants confondus : deux boutiques ne peuvent pas porter
  /// « le même » nom. Vide pour une boutique refusée (nom libéré).
  nameKey        String?    @unique @map("name_key") @db.VarChar(60)
  slug           String     @unique @db.VarChar(80)
  city           String     @db.VarChar(60)
  /// Mobile gabonais de contact, forme « +241077123456 » ; vide pour la boutique Kemdia
  contactPhone   String?    @map("contact_phone") @db.VarChar(16)
  description    String     @default("") @db.VarChar(500)
  status         ShopStatus @default(PENDING)
  /// Motif du refus ou de la suspension (montré au vendeur)
  statusReason   String?    @map("status_reason") @db.VarChar(300)
  /// Administrateur de la dernière décision (module identity, UUID)
  reviewedBy     String?    @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?  @map("reviewed_at") @db.Timestamptz(3)
  submittedAt    DateTime   @map("submitted_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, submittedAt, id])
  @@map("shops")
  @@schema("vendors")
}
