// Module orders : panier serveur (S5-T01, ADR-0023) ; commandes au S5-T02.
// Chaque modèle de ce fichier porte @@schema("orders").
// Aucune relation vers les autres modules (ADR-0006) : on garde l'UUID du compte (identity) et de la variante (catalog).
// Règles posées en SQL dans la migration (Prisma ne sait pas les décrire) : quantité de 1 à 20 par ligne,
// 50 lignes au plus par panier (déclencheur).

/// Panier d'un compte : un seul par compte. Supprimé après 90 jours sans activité (ménage horaire).
model Cart {
  id        String     @id @db.Uuid
  /// Compte propriétaire (module identity) : UUID seul, sans clé étrangère entre modules
  accountId String     @unique @map("account_id") @db.Uuid
  /// Dernière réunion appliquée (identifiant tiré par le navigateur) : une réunion répétée ne double rien
  lastMergeId String?  @map("last_merge_id") @db.Uuid
  items     CartItem[]
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Dernière activité (lecture ou modification) : sert au ménage des paniers abandonnés
  updatedAt DateTime   @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([updatedAt])
  @@map("carts")
  @@schema("orders")
}

/// Ligne du panier : une variante et sa quantité. JAMAIS de prix : il est relu dans le catalogue à chaque lecture (BR-004).
model CartItem {
  cartId    String   @map("cart_id") @db.Uuid
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  /// Variante du catalogue : UUID seul, sans clé étrangère entre modules
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  @@id([cartId, variantId])
  @@map("cart_items")
  @@schema("orders")
}

// ─── Commandes (S5-T02, ADR-0024) ─────────────────────────────────────────────────────────

/// En attente de paiement (Mobile Money) → confirmée → en préparation → expédiée → livrée ; annulée.
enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED

  @@map("order_status")
  @@schema("orders")
}

enum PaymentMethod {
  AIRTEL
  MOOV
  COD

  @@map("payment_method")
  @@schema("orders")
}

/// Annulée par le client (avant l'expédition) ou paiement non reçu à temps.
enum CancelReason {
  CLIENT
  PAYMENT_EXPIRED

  @@map("cancel_reason")
  @@schema("orders")
}

/// Commande d'un compte. Montants calculés par le serveur (BR-004) et figés : la base refuse de les modifier.
model Order {
  id                   String              @id @db.Uuid
  /// Numéro montré au client (« KMD-7F3K9Q »), tiré au hasard (BR-042)
  reference            String              @unique @db.VarChar(10)
  /// Compte (module identity) : UUID seul, sans clé étrangère entre modules
  accountId            String              @map("account_id") @db.Uuid
  /// Clé tirée par le site : la même demande renvoyée ne crée pas deux commandes
  idempotencyKey       String              @map("idempotency_key") @db.Uuid
  /// Empreinte SHA-256 de la demande (adresse, paiement, total) : une clé ne sert qu'à une même commande
  requestHash          String              @map("request_hash") @db.Char(64)
  status               OrderStatus
  paymentMethod        PaymentMethod       @map("payment_method")
  /// Numéro Mobile Money (+241…) ; vide pour le paiement à la livraison
  paymentPhone         String?             @map("payment_phone") @db.VarChar(13)
  subtotal             Int
  /// Réduction du coupon (S5-T03), sur les articles seulement : total = articles − réduction + livraison
  discount             Int                 @default(0)
  couponCode           String?             @map("coupon_code") @db.VarChar(20)
  deliveryFee          Int                 @map("delivery_fee")
  total                Int
  deliveryName         String              @map("delivery_name") @db.VarChar(120)
  deliveryPhone        String              @map("delivery_phone") @db.VarChar(13)
  deliveryCityId       String              @map("delivery_city_id") @db.VarChar(40)
  deliveryCityName     String              @map("delivery_city_name") @db.VarChar(60)
  deliveryNeighborhood String              @map("delivery_neighborhood") @db.VarChar(80)
  deliveryLandmark     String              @map("delivery_landmark") @db.VarChar(200)
  deliveryDaysMin      Int                 @map("delivery_days_min")
  deliveryDaysMax      Int                 @map("delivery_days_max")
  /// En attente de paiement : au-delà, annulée et stock remis en vente
  paymentDueAt         DateTime?           @map("payment_due_at") @db.Timestamptz(3)
  cancelledAt          DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  cancelReason         CancelReason?       @map("cancel_reason")
  items                OrderItem[]
  history              OrderStatusChange[]
  couponRedemption     CouponRedemption?
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@unique([accountId, idempotencyKey])
  @@index([accountId, createdAt])
  @@index([status, paymentDueAt])
  @@map("orders")
  @@schema("orders")
}

/// Article commandé : copie figée au moment de la commande (titre, prix…). La base refuse toute modification.
model OrderItem {
  orderId     String  @map("order_id") @db.Uuid
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// Variante et produit du catalogue : UUID seuls
  variantId   String  @map("variant_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  title       String  @db.VarChar(120)
  variantName String  @map("variant_name") @db.VarChar(80)
  image       String? @db.VarChar(300)
  unitPrice   Int     @map("unit_price")
  quantity    Int
  lineTotal   Int     @map("line_total")
  position    Int

  @@id([orderId, variantId])
  @@map("order_items")
  @@schema("orders")
}

/// Historique des statuts (suivi de commande), en ajout seul.
model OrderStatusChange {
  id      String      @id @db.Uuid
  orderId String      @map("order_id") @db.Uuid
  order   Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  status  OrderStatus
  at      DateTime    @default(now()) @db.Timestamptz(3)

  @@index([orderId, at])
  @@map("order_status_history")
  @@schema("orders")
}

// ─── Coupons (S5-T03, ADR-0025) ───────────────────────────────────────────────────────────

enum CouponKind {
  PERCENT
  FIXED

  @@map("coupon_kind")
  @@schema("orders")
}

/// Coupon de réduction. Ses règles sont figées par la base une fois créé : seuls l'activation et le compteur changent.
model Coupon {
  id                 String             @id @db.Uuid
  /// En majuscules (saisie sans casse)
  code               String             @unique @db.VarChar(20)
  kind               CouponKind
  /// Pourcentage (1 à 90) ou montant en FCFA
  value              Int
  maxDiscount        Int?               @map("max_discount")
  minSubtotal        Int?               @map("min_subtotal")
  startsAt           DateTime           @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime?          @map("ends_at") @db.Timestamptz(3)
  usageLimit         Int?               @map("usage_limit")
  /// Utilisations comptées (commandes non annulées), changé de façon atomique (BR-030)
  usedCount          Int                @default(0) @map("used_count")
  perAccountLimit    Int?               @map("per_account_limit")
  /// BR-031 : s'applique aussi aux articles déjà en promotion
  stackableWithSales Boolean            @default(false) @map("stackable_with_sales")
  active             Boolean            @default(true)
  /// Administrateur qui l'a créé (module identity) : UUID seul
  createdBy          String             @map("created_by") @db.Uuid
  redemptions        CouponRedemption[]
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("coupons")
  @@schema("orders")
}

/// Utilisation d'un coupon par une commande (une au plus par commande). Rendue si la commande est annulée.
model CouponRedemption {
  id         String    @id @db.Uuid
  couponId   String    @map("coupon_id") @db.Uuid
  coupon     Coupon    @relation(fields: [couponId], references: [id], onDelete: Restrict)
  orderId    String    @unique @map("order_id") @db.Uuid
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// Compte (module identity) : UUID seul
  accountId  String    @map("account_id") @db.Uuid
  amount     Int
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  releasedAt DateTime? @map("released_at") @db.Timestamptz(3)

  @@index([couponId, accountId])
  @@map("coupon_redemptions")
  @@schema("orders")
}
