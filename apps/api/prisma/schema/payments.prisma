// Module payments : paiements des commandes et remboursements (S5-T04, ADR-0026).
// Chaque modèle de ce fichier porte @@schema("payments").
// Aucune relation vers les autres modules (ADR-0006) : on garde l'UUID de la commande (orders) et des comptes (identity).
// Règles posées en SQL dans la migration (Prisma ne sait pas les décrire) : numéros, montants, statuts seulement dans
// l'ordre prévu, champs figés, aucune suppression.

/// En attente de la validation sur le téléphone → réussi / échoué / expiré (un essai expiré peut encore réussir).
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED

  @@map("payment_status")
  @@schema("payments")
}

enum PaymentChannel {
  AIRTEL
  MOOV
  COD

  @@map("payment_channel")
  @@schema("payments")
}

enum RefundStatus {
  TO_DO
  DONE

  @@map("refund_status")
  @@schema("payments")
}

/// Commande payée puis annulée par un administrateur, ou argent reçu alors que la commande n'attendait plus de paiement.
enum RefundReason {
  ADMIN_CANCEL
  UNEXPECTED_PAYMENT
  /// Commande payée puis refusée par un vendeur, ou sans réponse d'un vendeur à temps (S6-T07)
  VENDOR_CANCEL
  /// Commande payée, livraison impossible puis annulée (S7-T01)
  DELIVERY_CANCEL

  @@map("refund_reason")
  @@schema("payments")
}

/// Un essai de paiement Mobile Money (3 au plus par commande), ou l'encaissement à la livraison.
model Payment {
  id            String         @id @db.Uuid
  /// Commande (module orders) : UUID seul, sans clé étrangère entre modules
  orderId       String         @map("order_id") @db.Uuid
  /// Compte du client (module identity) : UUID seul
  accountId     String         @map("account_id") @db.Uuid
  method        PaymentChannel
  /// Montant demandé ou encaissé (total de la commande), en FCFA
  amount        Int
  /// Numéro Mobile Money (+241…) ; vide pour l'encaissement à la livraison
  phone         String?        @db.VarChar(13)
  status        PaymentStatus
  /// Numéro de l'essai pour cette commande (3 comptés au plus ; 10 lignes au plus avec les refus de l'opérateur)
  attempt       Int            @db.SmallInt
  /// Fournisseur qui a traité l'essai (« simule », « especes »…)
  provider      String         @db.VarChar(20)
  /// Référence de l'opération chez le fournisseur (posée une seule fois)
  providerRef   String?        @unique @map("provider_ref") @db.VarChar(100)
  failureReason String?        @map("failure_reason") @db.VarChar(60)
  /// Administrateur qui a noté l'encaissement à la livraison (module identity) : UUID seul
  collectedBy   String?        @map("collected_by") @db.Uuid
  /// Sans réponse de l'opérateur à cette date, l'essai est expiré
  expiresAt     DateTime?      @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt   DateTime?      @map("completed_at") @db.Timestamptz(3)
  updatedAt     DateTime       @default(now()) @map("updated_at") @db.Timestamptz(3)
  refund        Refund?

  /// Compte effacé (S7-T08) : numéro de téléphone effacé
  anonymizedAt DateTime? @map("anonymized_at") @db.Timestamptz(3)

  @@unique([orderId, attempt])
  @@index([status, expiresAt])
  @@index([phone, createdAt])
  @@map("payments")
  @@schema("payments")
}

/// Remboursement à faire puis fait (suivi manuel par un administrateur en attendant l'API de l'opérateur).
model Refund {
  id                String         @id @db.Uuid
  /// Paiement remboursé : un remboursement au plus par paiement
  paymentId         String         @unique @map("payment_id") @db.Uuid
  payment           Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  /// Commande (module orders) : UUID seul, et son numéro (copié : l'administrateur s'y retrouve)
  orderId           String         @map("order_id") @db.Uuid
  orderReference    String         @map("order_reference") @db.VarChar(10)
  amount            Int
  method            PaymentChannel
  /// Vide seulement pour un remboursement fait d'un compte effacé (S7-T08)
  phone             String?        @db.VarChar(13)
  reason            RefundReason
  status            RefundStatus
  /// Référence du remboursement chez l'opérateur, notée par l'administrateur
  externalReference String?        @unique @map("external_reference") @db.VarChar(100)
  /// Administrateur qui l'a noté fait (module identity) : UUID seul
  doneBy            String?        @map("done_by") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  doneAt            DateTime?      @map("done_at") @db.Timestamptz(3)
  updatedAt         DateTime       @default(now()) @map("updated_at") @db.Timestamptz(3)

  /// Compte effacé (S7-T08) : numéro de téléphone effacé
  anonymizedAt DateTime? @map("anonymized_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([orderId])
  @@map("refunds")
  @@schema("payments")
}

/// Notification reçue de l'opérateur (S5-T05, ADR-0027) : son identifiant n'est accepté qu'une fois (rejeu refusé).
/// En ajout seul.
model ProviderEvent {
  /// Identifiant de la notification, tiré par l'opérateur
  id         String   @id @db.Uuid
  /// Essai concerné : UUID seul
  paymentId  String   @map("payment_id") @db.Uuid
  type       String   @db.VarChar(30)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@index([paymentId])
  @@map("provider_events")
  @@schema("payments")
}

// ─── Factures (S5-T06, ADR-0028) ──────────────────────────────────────────────────────────

/// Informations de l'entreprise imprimées sur les factures (une seule ligne, id = 1), modifiées par un administrateur.
model BillingSettings {
  id            Int       @id @default(1) @db.SmallInt
  /// Raison sociale
  legalName     String    @map("legal_name") @db.VarChar(120)
  address       String    @db.VarChar(200)
  city          String    @db.VarChar(60)
  phone         String    @db.VarChar(30)
  email         String    @db.VarChar(120)
  /// NIF (numéro d'identification fiscale)
  taxId         String    @map("tax_id") @db.VarChar(40)
  /// RCCM (registre du commerce)
  tradeRegister String    @map("trade_register") @db.VarChar(40)
  /// Mention de TVA (« TVA non applicable » tant que le seuil n'est pas atteint, BR-023)
  vatMention    String    @map("vat_mention") @db.VarChar(120)
  /// Dernier administrateur qui l'a changé (module identity) : UUID seul
  updatedBy     String?   @map("updated_by") @db.Uuid
  updatedAt     DateTime? @map("updated_at") @db.Timestamptz(3)

  @@map("billing_settings")
  @@schema("payments")
}

/// Facture ou avoir.
enum DocumentKind {
  INVOICE
  CREDIT_NOTE

  @@map("document_kind")
  @@schema("payments")
}

/// Dernier numéro attribué, par type et par année : la numérotation n'a jamais de trou (verrou de ligne, même transaction).
model InvoiceCounter {
  kind       DocumentKind
  year       Int          @db.SmallInt
  lastNumber Int          @map("last_number")

  @@id([kind, year])
  @@map("invoice_counters")
  @@schema("payments")
}

/// Facture (au paiement reçu) ou avoir (commande facturée puis annulée). Figée : seul le suivi de l'e-mail change.
model Invoice {
  id                String         @id @db.Uuid
  /// « KMD-F-2026-000001 » ou « KMD-A-2026-000001 »
  number            String         @unique @db.VarChar(20)
  kind              DocumentKind
  /// Commande (module orders) : UUID seul, et son numéro
  orderId           String         @map("order_id") @db.Uuid
  orderReference    String         @map("order_reference") @db.VarChar(10)
  /// Compte du client (module identity) : UUID seul
  accountId         String         @map("account_id") @db.Uuid
  /// Avoir : la facture qu'il annule
  creditedInvoiceId String?        @unique @map("credited_invoice_id") @db.Uuid
  issuedAt          DateTime       @map("issued_at") @db.Timestamptz(3)
  subtotal          Int
  discount          Int
  deliveryFee       Int            @map("delivery_fee")
  total             Int
  vatMention        String         @map("vat_mention") @db.VarChar(120)
  /// Copies figées : entreprise, client (nom, téléphone, adresse, e-mail), lignes
  seller            Json
  buyer             Json
  lines             Json
  paymentMethod     PaymentChannel @map("payment_method")
  /// Référence de l'opération chez l'opérateur (Mobile Money) ; vide pour les espèces
  paymentReference  String?        @map("payment_reference") @db.VarChar(100)
  /// Envoi par e-mail : essais (5 au plus, de plus en plus espacés), prochain essai et date de réussite
  emailAttempts     Int            @default(0) @map("email_attempts")
  emailNextAt       DateTime?      @map("email_next_at") @db.Timestamptz(3)
  emailSentAt       DateTime?      @map("email_sent_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([orderId, kind])
  @@index([accountId])
  @@index([emailSentAt, emailNextAt])
  @@map("invoices")
  @@schema("payments")
}
