# Configuration de l'API Kemdia — copier en .env pour le développement local (.env n'est jamais commité).
# Toutes les variables sont vérifiées au démarrage : une valeur invalide empêche l'API de démarrer.

# development | test | production
NODE_ENV=development
# local | demo | staging | production (affiché par /api/health)
APP_ENV=local
# Version de l'image (fournie par le pipeline ; obligatoire en production)
APP_VERSION=dev

HOST=0.0.0.0
PORT=4000

# fatal | error | warn | info | debug | trace | silent  (debug et trace interdits en production)
LOG_LEVEL=info

# Origines autorisées à appeler l'API depuis un navigateur, séparées par des virgules.
# Vide par défaut : le site Next.js appelle l'API côté serveur, sans CORS.
CORS_ORIGINS=

# Nombre de relais devant l'API (Caddy en production : 1)
TRUST_PROXY=0

# Base PostgreSQL. Valeur par défaut en développement : la base de `docker compose up -d db`
# (postgresql://kemdia:kemdia@localhost:5432/kemdia). OBLIGATOIRE en production.
# Contient un mot de passe : ne jamais la coller dans un ticket, un message ou une capture.
DATABASE_URL=postgresql://kemdia:kemdia@localhost:5432/kemdia
# Connexions simultanées au plus (1 à 50)
DATABASE_POOL_MAX=10
# Durée maximale d'une requête SQL, en millisecondes (100 à 60000)
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Limitation de débit : requêtes par minute et par adresse IP (10 à 10000)
RATE_LIMIT_PER_MINUTE=120
# Clé secrète du site Kemdia (en-tête X-Kemdia-Internal-Key) : le site appelle l'API pour tous ses visiteurs
# depuis une seule adresse, il est donc exempté de la limite. 32 à 128 caractères [A-Za-z0-9_-].
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# À définir comme SECRET sur le serveur ; jamais dans Git. Vide = aucune exemption.
API_INTERNAL_KEY=
# Documentation interactive /api/docs et /api/v1/openapi.json (true | false).
# Par défaut : activée en développement, désactivée en production.
API_DOCS=

# Vérification par SMS (true | false). false tant qu'aucun fournisseur SMS n'est choisi (ADR-0015) :
# l'option téléphone est affichée « bientôt disponible » et l'API refuse d'envoyer un SMS.
SMS_ENABLED=false
